rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 16 && cleanName(n);
    }
    // name-filter:start (generated by moderation/build-name-filter.mjs)
    function nameText(n) {
      return n.lower().replace('0', 'o').replace('1', 'i').replace('3', 'e').replace('4', 'a').replace('5', 's').replace('7', 't').replace('8', 'b').replace('9', 'g').replace('@', 'a').replace('[$]', 's').replace('!', 'i').replace('[|]', 'i');
    }
    function cleanName(n) {
      return !nameText(n).replace('[^a-z]', '').replace('scunthorpe|matsushita|penistone|ashkenazi|shiitake|cockburn|ashkenaz|shitaye|shitake|basket|analys|water|watch|swank', '').matches('.*(fuk|fdp|fuck|cunt|shit|twat|slut|wank|jizz|porn|nazi|nigg|niga|iabb|arsch|fotze|penis|bitch|boner|boobs|busty|coons|dildo|fecal|felch|gspot|juggs|kinky|negro|panty|pikey|queaf|queef|shota|skeet|sucks|titty|tushy|whore|yiffy|pezon|malpt|merde|negre|cazzo|merda|porca|sorca|troia|zinne|asbak|bicha|cagar|foder|porra|queca|vadia|veado|amcga|amcgn|amlar|gotun|scmak|sikin|sikte|tasag|tasak|yarag|yarak|phuck|froci|qirje|bytha|kurve|bumsen|ficken|kacken|kanake|muschi|pimmel|pissen|scheie|titten|vogeln|wichse|beaner|bimbos|darkie|dommes|faggot|feltch|femdom|gaysex|girlon|goatcx|goatse|gokkun|hentai|honkey|hooker|incest|nambla|nignog|nipple|nudity|nutten|orgasm|punany|rectum|rimjob|sadism|sexcam|sodomy|spooge|tiedup|tosser|tranny|viagra|voyeur|voyuer|cabron|follar|mamada|marica|mierda|bordel|encule|foutre|gouine|pedale|putain|salaud|salope|arrusa|arruso|belino|bofilo|busone|cagata|checca|figone|fregna|ingoio|lofare|padulo|piscio|sborra|soccia|socmel|beffen|hoerig|hufter|kloten|naaien|neuken|oetlul|piesen|pijpen|poepen|rotzak|rukken|schijt|schoft|zeiken|zeiker|boceta|cabrao|cacete|chupar|fodase|peidar|amckta|gotler|kaltag|kaltak|orospu|sikler|sikmek|siktir|niquer|batard|tamere|qifsha|lavire|hitler|pimpern|asshole|ballgag|bangbus|bastard|bigtits|blowjob|bukkake|camgirl|cumming|cumshot|dolcett|dryhump|figging|fisting|footjob|goddamn|googirl|handjob|hotcarl|hugefat|humping|jackoff|jerkoff|jigaboo|kinbaku|livesex|mrhands|nawashi|panties|pegging|pissing|pisspig|playboy|raghead|schlong|shemale|shibari|spastic|splooge|strapon|swinger|tastemy|titties|topless|tubgirl|twinkie|upskirt|wetback|bollera|imbecil|kapullo|maricon|pendejo|bloblos|branler|chiasse|connard|deconne|enfoire|tapette|bagassa|battona|budiulo|cazzata|chiappa|cornuto|fottere|froscio|loffare|merdoso|minchia|nerchia|palloso|patonza|pippone|pisello|pompino|puppami|puttana|scopata|stronza|stronzo|zoccola|afberen|flamoes|flikker|rothoer|rukhond|temeier|balalao|caralho|colhoes|dumraio|lesbica|xochota|amcklar|cingene|saksocu|diocane|mongool|schlampe|tittchen|arsehole|assmunch|babeland|ballsack|bangbros|bareback|bigblack|birdlock|blumpkin|bollocks|bulldyke|bunghole|butthole|cameltoe|clitoris|cornhole|creampie|daterape|dogstyle|dpaction|eatmyass|fellatio|frotting|futanari|gangbang|genitals|goodpoop|goregasm|groupsex|hardcore|hotchick|jailbait|jiggaboo|kinkster|knobbing|omorashi|pedobear|phonesex|ponyplay|poontang|rosypalm|santorum|slanteye|sodomize|swastika|vibrator|wetdream|worldsex|chupeton|follador|hijaputa|hijoputa|branlage|branleur|chiottes|connasse|couilles|palucher|tringler|troncher|allupato|arrapato|bagascia|bocchino|bucaiolo|cazzimma|chiavare|chiavata|coglione|coglioni|ditalino|fottersi|guardone|lecchino|mignotta|pisciare|porcodue|porcozio|ruffiano|sborrone|sticchio|trombare|afrossen|afzuigen|boerelul|bokkelul|deballen|geilneef|klootoog|klootzak|opgeilen|oprotten|ouwehoer|standjeg|viespeuk|chochota|darorabo|vibrador|sikmemek|bougnoul|porcodio|dioporco|mortacci|siegheil|genocide|official|flittchen|hurensohn|kackwurst|onanieren|scheisser|schiesser|girlsicup|anilingus|babyjuice|ballgravy|barenaked|bastinado|blackcock|bootycall|fingering|giantcock|howtokill|jiggerboo|muffdiver|octopussy|pedophile|poopchute|shrimping|strappado|stripclub|threesome|throating|tongueina|towelhead|tribadism|urophilia|zoophilia|lameculos|macizorra|brackmard|branlette|branleuse|trouducul|baldracca|culattina|culattone|finocchio|fracicone|leccaculo|mannaggia|minchione|pinnolone|recchione|slinguare|slinguata|succhiami|succhione|aftrekken|belazeren|botergeil|draaikont|gratenkut|klerebeer|lulhannes|neukstier|paardelul|sletterig|stoephoer|tapijtnek|triootjeg|paneleiro|gotverene|gotvereni|otuzbirci|sharmouta|charmouta|ricchione|holocaust|moderator|anthropic|analritter|hackfresse|kackbratze|kampflesbe|schabracke|schnackeln|schwuchtel|autoerotic|babybatter|beaverlips|bestiality|bigbreasts|bluewaffle|bulletvibe|buttcheeks).*')
        && !nameText(n).replace('[^a-z]', '').replace('scunthorpe|matsushita|penistone|ashkenazi|shiitake|cockburn|ashkenaz|shitaye|shitake|basket|analys|water|watch|swank', '').matches('.*(circlejerk|deepthroat|doggystyle|domination|dominatrix|doubledong|fingerbang|footfetish|homoerotic|jellydonut|lemonparty|lovemaking|makemecome|masturbate|muffdiving|nsfwimages|paedophile|polesmoker|scissoring|spreadlegs|styledoggy|teabagging|thumbzilla|tightwhite|undressing|venusmound|violetwand|whitepower|gilipichis|gilipollas|hijadeputa|hijodeputa|jilipollas|bigornette|cramouille|filsdepute|grogniasse|pouffiasse|zigounette|assatanato|bocchinara|incazzarsi|pistolotto|rompiballe|rompipalle|sbrodolata|spompinare|sverginare|tarzanello|vaffanculo|aflebberen|bedonderen|befborstel|brugpieper|droogkloot|greppeldel|klaarkomen|opkankeren|ouwerukker|reetridder|voorjanlul|gotverende|morgenlatte|vollpfosten|ballkicking|balllicking|ballsucking|barelylegal|beastiality|bigknockers|coprolagnia|coprophilia|cunnilingus|dingleberry|doggiestyle|donkeypunch|ejaculation|fudgepacker|howtomurder|intercourse|nimphomania|nymphomania|shavedpussy|snowballing|sultrywomen|taintedlove|urethraplay|wrappingmen|chupapollas|soplagaitas|soplapollas|filledepute|grandefolle|niquetarace|ammucchiata|ziocantante|drooggeiler|eenwipmaken|gadverdamme|godverdomme|hoerenbuurt|hoerenloper|matennaaier|opznhondjes|pijpbekkieg|portiekslet|teringlijer|filhodaputa|gotverenler|sikersikmez|nardinamouk|madonnaccia|kankerlijer|blondeaction|blowyourload|brownshowers|cloverclamps|dendrophilia|dirtypillows|dirtysanchez|goldenshower|masturbating|masturbation|menageatrois|moundofvenus|oneguyonejar|shavedbeaver|suicidegirls|vorarephilia|hacerunapaja|tetasgrandes|poussecrotte|scorreggiare|smandrappata|afwerkplaats|boerenpummel|broekhoesten|dehoerspelen|gesodemieter|klootjesvolk|krentekakker|slikmijnzaad|trottoirteef|zakkenwasser|frangoassado|putaquepariu|vaitomarnocu|beavercleaver|carpetmuncher|dingleberries|girlsgonewild|malesquirting|pleasurechest|rustytrombone|yellowshowers|caciocappella|depijpuitgaan|eenbeurtgeven|luldebehanger|pleurislaaier|administrator|acrotomophilia|brunetteaction|onecuptwogirls|reversecowgirl|twogirlsonecup|besodemieteren|dehonduitlaten|kuttelikkertje|opsodemieteren|passarumcheque|putaquetepariu|schwanzlutscher|alaskanpipeline|conchadetumadre|sikilirsikilmez|alabamahotpocket|clevelandsteamer|leatherrestraint|wrinkledstarfish|brouterlecresson|dekofferinduiken|publiciteitsgeil).*')
        && !('-' + nameText(n).replace('[^a-z]+', '-') + '-').matches('.*-(admin|amcg|amck|amk|anal|anale|anus|ass|bbw|bdsm|bicot|bite|bitte|boob|bosta|butt|byth|cazz|cesso|chatte|chinetoque|clit|clito|cock|cocks|cona|conne|cono|coon|corno|cul|culo|cum|dick|dvda|dyke|etron|fag|fica|fick|figa|foda|gic|gogol|gotveren|grope|guro|hoer|horny|hure|kahba|kanker|kar|kari|kehba|kike|kkk|kont|kurva|kut|lul|milf|mod|mof|mong|mongol|mose|neger|nique|nonce|nsfw|ntm|nutte|nympho|orgy|paedo|paki|palle|pd|pede|pedo|picio|pidh|pidhi|pik|pinche|poep|poof|poon|potta|pthc|pubes|pussy|puta|pute|puto|qahba|qij|quim|ramera|rape|raping|rapist|reet|retard|rimming|scat|semen|sexo|sik|sike|siki|slet|smut|snatch|snol|spic|spunk|staff|stront|suce|suck|support|tering|tette|teuch|tg|tit|tits|trique|twink|tyfus|vagina|verga|vulva|wijf|xana|xxx|yaoi|youpin|zamel|zebi|zemel|zob)-.*')
        && !('-' + n.lower().replace('[^a-z]+', '-') + '-').matches('.*-(admin|amcg|amck|amk|anal|anale|anus|ass|bbw|bdsm|bicot|bite|bitte|boob|bosta|butt|byth|cazz|cesso|chatte|chinetoque|clit|clito|cock|cocks|cona|conne|cono|coon|corno|cul|culo|cum|dick|dvda|dyke|etron|fag|fica|fick|figa|foda|gic|gogol|gotveren|grope|guro|hoer|horny|hure|kahba|kanker|kar|kari|kehba|kike|kkk|kont|kurva|kut|lul|milf|mod|mof|mong|mongol|mose|neger|nique|nonce|nsfw|ntm|nutte|nympho|orgy|paedo|paki|palle|pd|pede|pedo|picio|pidh|pidhi|pik|pinche|poep|poof|poon|potta|pthc|pubes|pussy|puta|pute|puto|qahba|qij|quim|ramera|rape|raping|rapist|reet|retard|rimming|scat|semen|sexo|sik|sike|siki|slet|smut|snatch|snol|spic|spunk|staff|stront|suce|suck|support|tering|tette|teuch|tg|tit|tits|trique|twink|tyfus|vagina|verga|vulva|wijf|xana|xxx|yaoi|youpin|zamel|zebi|zemel|zob)-.*');
    }
    // name-filter:end
    function ownerPath(uid) {
      return /databases/$(database)/documents/owners/$(uid);
    }
    function namePath(key) {
      return /databases/$(database)/documents/names/$(key);
    }

    // Unique names: the document id is the normalised name, first come first served.
    // One name per player: claiming a new name must move owners/{uid} to it and release the old one in the same commit.
    match /names/{key} {
      allow read: if true;
      allow create: if request.auth != null
        && key.matches('^[a-z0-9_.-]{2,32}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name)
        && getAfter(ownerPath(request.auth.uid)).data.key == key
        && (!exists(ownerPath(request.auth.uid))
            || !existsAfter(namePath(get(ownerPath(request.auth.uid)).data.key)));
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Pointer from a player to the one name they own.
    match /owners/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['key'])
        && request.resource.data.key is string
        && getAfter(namePath(request.resource.data.key)).data.uid == uid;
      allow delete: if false;
    }

    // Trending: everyone reads, each player writes only their own row, under the name they own.
    match /board/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'owed', 'deeds', 'views', 'runs', 'best', 'at'])
        && validName(request.resource.data.name)
        && get(namePath(get(ownerPath(uid)).data.key)).data.name == request.resource.data.name
        && request.resource.data.owed is int && request.resource.data.owed >= 0
        && request.resource.data.deeds is int && request.resource.data.deeds >= 0
        && request.resource.data.views is int && request.resource.data.views >= 0 && request.resource.data.views <= 1000000000
        && request.resource.data.runs is int && request.resource.data.runs >= 0
        && request.resource.data.best is int && request.resource.data.best >= 0;
      allow delete: if false;
    }
  }
}
